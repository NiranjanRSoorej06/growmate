# Mandatory for any hosted deployment (Render Static Site, VPS, etc.).
# Vite replaces this at build time. Example: https://growmate-api.onrender.com
# Leave empty for local development: Vite proxies /api to localhost:8000.
VITE_API_URL=

# Optional. Enables browser error reporting (only when VITE_SENTRY_DSN is set).
VITE_SENTRY_DSN=
