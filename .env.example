# Copy to .env and edit. Never commit .env.

# --- Local AI (required for plans and chat) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Seconds to wait for the model. Raise this on slow machines.
OLLAMA_TIMEOUT=120

# --- Storage ---
# Defaults to backend/growmate.db
# DATABASE_PATH=

# --- CORS (only needed if the frontend is served from another origin) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: error monitoring ---
SENTRY_DSN=

# --- Optional: web research (SerpApi). Leave empty to disable. ---
SERPAPI_KEY=
